{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axmol.dev/versions/schema/v1.json",
  "title": "Axmol release registry",
  "description": "Machine-readable registry of Axmol releases served to tooling such as Axmol Hub. Generated by generate-releases.ps1 from the GitHub Releases API; see https://axmol.dev/versions/index.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "generatedAt",
    "project",
    "source",
    "channels",
    "versions"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri",
      "description": "URL of this schema document."
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "Version of the registry document structure, independent of the URL path."
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Generation timestamp, ISO 8601 UTC."
    },
    "project": {
      "type": "string",
      "const": "axmol"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "releasesApi", "attribution"],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "releasesApi": {
          "type": "string",
          "format": "uri"
        },
        "attribution": {
          "type": "string"
        }
      }
    },
    "channels": {
      "type": "object",
      "minProperties": 1,
      "description": "Channel map keyed by channel id. New channels may be added without affecting existing consumers.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "line", "latest"],
        "properties": {
          "label": {
            "type": "string"
          },
          "line": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+$"
          },
          "latest": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "description": "Newest version in this channel. Must match exactly one entry in versions[]."
          }
        }
      }
    },
    "versions": {
      "type": "array",
      "minItems": 1,
      "description": "Versions sorted by patch number, newest first.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "tag",
          "channel",
          "line",
          "prerelease",
          "releaseDate",
          "releaseUrl",
          "archives",
          "artifacts"
        ],
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "description": "Semantic version without the leading v."
          },
          "tag": {
            "type": "string",
            "pattern": "^v\\d+\\.\\d+\\.\\d+$",
            "description": "Git tag as released, including the leading v."
          },
          "channel": {
            "type": "string"
          },
          "line": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+$"
          },
          "prerelease": {
            "type": "boolean"
          },
          "releaseDate": {
            "type": "string",
            "format": "date-time"
          },
          "releaseUrl": {
            "type": "string",
            "format": "uri",
            "description": "GitHub Release page, the human-facing download entry point."
          },
          "archives": {
            "type": "object",
            "additionalProperties": false,
            "required": ["zip", "tarball"],
            "description": "Source archives of the release tag.",
            "properties": {
              "zip": {
                "type": "string",
                "format": "uri"
              },
              "tarball": {
                "type": "string",
                "format": "uri"
              }
            }
          },
          "artifacts": {
            "type": "array",
            "description": "Reserved for per-platform artifacts. Always empty in schema v1.0; consumers must tolerate an empty array and may ignore unknown entries added later.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["platform", "url"],
              "properties": {
                "platform": {
                  "type": "string"
                },
                "arch": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "size": {
                  "type": "integer"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          }
        }
      }
    }
  }
}
